{{! Attributes Weapon ModifiersTab }}
<section
        class='tab attributes {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesWeaponModifiers'
>
    {{!-- As you add new fields, add them in here! --}}
    <h3>Weapon Modifiers</h3>

    {{log "system.weaponModifiers data" system.weaponModifiers}}
    {{log "system.weaponModifiers fields" systemFields.weaponModifiers.element.fields}}

    {{#each system.weaponModifiers as |weaponModifier wmIdx|}}

        <fieldset>
            <legend data-tooltip="SWES.Combat-Item.FIELDS.weaponModifiers.hint">{{localize
                    "SWES.Combat-Item.FIELDS.weaponModifiers.label"}}</legend>

            {{formField @root.systemFields.weaponModifiers.element.fields.unarmed
                        name=(concat "system.weaponModifiers." wmIdx ".unarmed")
                        value=weaponModifier.unarmed localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.unarmed.label"
                        rootId=partId}}

            {{formField @root.systemFields.weaponModifiers.element.fields.skillKey
                        name=(concat "system.weaponModifiers." wmIdx ".skillKey")
                        value=weaponModifier.skillKey localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.skillKey.label"
                        rootId=partId}}

            {{formField @root.systemFields.weaponModifiers.element.fields.damage
                        name=(concat "system.weaponModifiers." wmIdx ".damage")
                        value=weaponModifier.damage localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.damage.label"
                        rootId=partId}}

            {{formField @root.systemFields.weaponModifiers.element.fields.crit
                        name=(concat "system.weaponModifiers." wmIdx ".crit")
                        value=weaponModifier.crit localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.crit.label"
                        rootId=partId}}

            {{formField @root.systemFields.weaponModifiers.element.fields.critSub
                        name=(concat "system.weaponModifiers." wmIdx ".critSub")
                        value=weaponModifier.critSub localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.critSub.label"
                        rootId=partId}}

            {{formField @root.systemFields.weaponModifiers.element.fields.rangeValue
                        name=(concat "system.weaponModifiers." wmIdx ".rangeValue")
                        value=weaponModifier.rangeValue localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.rangeValue.label"
                        rootId=partId}}

            {{formField @root.systemFields.weaponModifiers.element.fields.range
                        name=(concat "system.weaponModifiers." wmIdx ".range")
                        value=weaponModifier.range localize=true
                        label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.range.label"
                        rootId=partId}}

            {{#each weaponModifier.qualities as |quality qIdx|}}

                <fieldset>
                    <legend data-tooltip="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.qualities.hint">{{localize
                            "SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.qualities.label"}}</legend>

                    {{formField @root.systemFields.weaponModifiers.element.fields.qualities.element.fields.key
                                name=(concat "system.weaponModifiers." wmIdx ".qualities." qIdx ".key")
                                value=quality.key localize=true
                                label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.qualities.element.FIELDS.key.label"
                                rootId=partId}}

                    {{formField @root.systemFields.weaponModifiers.element.fields.qualities.element.fields.count
                                name=(concat "system.weaponModifiers." wmIdx ".qualities." qIdx ".count")
                                value=quality.count localize=true
                                label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.qualities.element.FIELDS.count.label"
                                rootId=partId}}

                </fieldset>

            {{/each}}

            {{#each weaponModifier.baseMods as |mod modIdx|}}

                <fieldset>
                    <legend data-tooltip="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.mods.hint">{{localize
                            "SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.mods.label"}}</legend>

                    {{formField @root.systemFields.weaponModifiers.element.fields.mods.element.fields.miscDesc
                                name=(concat "system.weaponModifiers." wmIdx ".mods." modIdx ".miscDesc")
                                value=mod.miscDesc localize=true
                                label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.mods.element.FIELDS.miscDesc.label"
                                rootId=partId}}

                    {{formField @root.systemFields.weaponModifiers.element.fields.mods.element.fields.count
                                name=(concat "system.weaponModifiers." wmIdx ".mods." modIdx ".count")
                                value=mod.count localize=true
                                label="SWES.Combat-Item.FIELDS.weaponModifiers.element.FIELDS.mods.element.FIELDS.count.label"
                                rootId=partId}}

                </fieldset>

            {{/each}}

        </fieldset>

    {{/each}}

</section>