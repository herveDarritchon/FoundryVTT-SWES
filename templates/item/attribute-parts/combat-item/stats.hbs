{{! Attributes Stats }}
<section
        class='tab attributes {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesStats'
>
    {{! As you add new fields, add them in here! }}
    <h1>Attributes</h1>
    <div>

        {{#if (eq item.type "armor")}}
            {{> "systems/swes/templates/item/attribute-parts/combat-item/armor/armor.hbs"}}
        {{/if}}

        {{#if (eq item.type "weapon")}}
            {{> "systems/swes/templates/item/attribute-parts/combat-item/weapon/weapon.hbs"}}
        {{/if}}

        {{#if (eq item.type "gear")}}
            {{> "systems/swes/templates/item/attribute-parts/combat-item/gear/gear.hbs"}}
        {{/if}}

        {{formField systemFields.encumbrance value=system.encumbrance}}

        {{formField systemFields.hp value=system.hp classes="slim" disabled=true rootId=partId}}

        {{formField systemFields.rarity value=system.rarity classes="slim" rootId=partId}}

        <fieldset>
            <legend data-tooltip="SWES.Combat-Item.FIELDS.categories.hint">{{localize
                    "SWES.Combat-Item.FIELDS.categories.label"}}</legend>
                {{formField @root.systemFields.categories value=system.categories localize=true rootId=partId}}
        </fieldset>

    </div>

</section>
