{{! Attributes Stats }}
<section
        class='tab attributes {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesStats'
>
    {{! As you add new fields, add them in here! }}
    <h1>Attributes</h1>
    <div>

        {{#if (eq item.type "armor")}}
            {{> "systems/swes/templates/item/attribute-parts/combat-item/armor/armor.hbs"}}
        {{/if}}

        {{#if (eq item.type "weapon")}}
            {{> "systems/swes/templates/item/attribute-parts/combat-item/weapon/weapon.hbs"}}
        {{/if}}

        {{#if (eq item.type "gear")}}
            {{> "systems/swes/templates/item/attribute-parts/combat-item/gear/gear.hbs"}}
        {{/if}}

        {{formField systemFields.encumbrance value=system.encumbrance}}

        {{formField systemFields.hp value=system.hp}}

        {{formField systemFields.rarity value=system.rarity}}

        {{!--
               {{#each system.categories as |category|}}
                    {{formField systemFields.category value=category}}
                {{/each}}
        --}}

        {{!--
        {{#each system.categories as |category|}}
            <label for="category">{{localize "ARMOR.Sheet.attributes.category.label"}}</label>
            <input id="category" name="system.category" type="text" value="{{category}}"
                   placeholder="Category"/>
        {{/each}}
        --}}

    </div>

</section>
