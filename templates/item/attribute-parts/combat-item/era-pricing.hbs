{{! Attributes Era PricingTab }}
<section
        class='tab attributes {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesEraPricing'
>
    {{! As you add new fields, add them in here! }}
    <h3>Era Pricing</h3>

    <fieldset>
        <legend data-tooltip="SWES.Combat-Item.era-pricing.hint">{{localize
                "SWES.Combat-Item.era-pricing.label"}}</legend>

        {{#each system.eraPricing as |eraPrice idx|}}

            {{formField @root.systemFields.eraPricing.element.fields.name
                        name=(concat "system.eraPricing." idx ".name")
                        value=eraPrice.name localize=true
                        placeholder=(localize "SWES.Combat-Item.FIELDS.era-pricing.name.placeholder")
                        rootId=partId}}
            {{formField @root.systemFields.eraPricing.element.fields.price
                        name=(concat "system.eraPricing." idx ".price")
                        value=eraPrice.price localize=true
                        rootId=partId}}
            {{formField @root.systemFields.eraPricing.element.fields.rarity
                        name=(concat "system.eraPricing." idx ".rarity")
                        value=eraPrice.rarity localize=true
                        rootId=partId}}
            {{formField @root.systemFields.eraPricing.element.fields.restricted
                        name=(concat "system.eraPricing." idx ".restricted")
                        value=eraPrice.restricted localize=true
                        rootId=partId}}
        {{/each}}

    </fieldset>

</section>