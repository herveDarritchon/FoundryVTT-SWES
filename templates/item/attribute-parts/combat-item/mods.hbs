{{! Attributes ModsTab }}
<section
        class='tab attributes {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesMods'
>
    {{!-- As you add new fields, add them in here! --}}
    <h1>Modifiers</h1>

    {{#each system.mods as |mod|}}
    <fieldset>
        <legend data-tooltip="SWES.Combat-Item.FIELDS.Mod.hint">{{localize
                "SWES.Combat-Item.FIELDS.Mod.label"}}</legend>
        {{formField @root.systemFields.mods.element.fields.key value=mod.key localize=true rootId=partId}}
        {{formField @root.systemFields.mods.element.fields.miscDesc value=mod.miscDesc localize=true rootId=partId}}
        {{formField @root.systemFields.mods.element.fields.count value=mod.count localize=true rootId=partId}}
        {{formField @root.systemFields.mods.element.fields.index value=mod.index localize=true rootId=partId}}
        {{formField @root.systemFields.mods.element.fields.defZone value=mod.defZone localize=true rootId=partId}}

        {{#each mod.dieModifiers as |dieModifier|}}
            <fieldset>
                <legend data-tooltip="SWES.Combat-Item.FIELDS.Mod.FIELDS.DieModifier.hint">{{localize
                        "SWES.Combat-Item.FIELDS.Mod.FIELDS.DieModifier.label"}}</legend>

                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.skillKey
                            value=dieModifier.skillKey localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.skillChar
                            value=dieModifier.skillChar localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.skillType
                            value=dieModifier.skillType localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.boostCount
                            value=dieModifier.boostCount localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.advantageCount
                            value=dieModifier.advantageCount localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.threatCount
                            value=dieModifier.threatCount localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.setbackCount
                            value=dieModifier.setbackCount localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.upgradeAbilityCount
                            value=dieModifier.upgradeAbilityCount localize=true rootId=partId}}
                {{formField @root.systemFields.mods.element.fields.dieModifiers.element.fields.successCount
                            value=dieModifier.successCount localize=true rootId=partId}}
            </fieldset>

        </fieldset>
        {{/each}}

    {{/each}}

</section>
