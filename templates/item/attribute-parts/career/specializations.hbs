        data-tab='attributesCareerSpecializations'
>

    <h3>{{localize "SWES.Item.Tabs.AttributesCareerSpecializations"}}</h3>

    <fieldset>
        <legend data-tooltip="SWES.Career-Item.specializations.hint">{{localize
