{{! Career Specialization Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesCareerSpecializations'
>
    <h3>Career Specializations</h3>

    {{log "Career Specializations" this}}

    <fieldset>
        <legend data-tooltip="SWES.Career-Item.career-specializations.hint">{{localize
                "SWES.Career-Item.career-specializations.label"}}</legend>
        {{formField @root.systemFields.careerSpecializations value=system.careerSpecializations localize=true rootId=partId}}
    </fieldset>
</section>