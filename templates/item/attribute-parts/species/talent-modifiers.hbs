{{! Talent Modifiers Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesTalentModifiers'
>

    <h3>{{localize "SWES.Item.Tabs.AttributesTalentModifiers"}}</h3>

    {{#each system.talentModifiers as |modifier talentIdx|}}
        <fieldset>
            <legend data-tooltip="SWES.Species-Item.talent-modifiers.hint">{{localize
                    "SWES.Species-Item.talent-modifiers.label"}}</legend>

            {{formField @root.systemFields.talentModifiers.element.fields.key
                        name=(concat "system.talentModifiers." talentIdx ".key")
                        value=modifier.key localize=true
                        label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.key.label")
                        rootId=partId}}

            {{formField @root.systemFields.talentModifiers.element.fields.subSpeciesKey
                        name=(concat "system.talentModifiers." talentIdx ".subSpeciesKey")
                        value=modifier.subSpeciesKey localize=true
                        label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.sub-species-key.label")
                        rootId=partId}}

            {{formField @root.systemFields.talentModifiers.element.fields.rankStart
                        name=(concat "system.talentModifiers." talentIdx ".rankStart")
                        value=modifier.rankStart localize=true
                        label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.rank-start.label")
                        rootId=partId}}

            {{formField @root.systemFields.talentModifiers.element.fields.rankAdd
                        name=(concat "system.talentModifiers." talentIdx ".rankAdd")
                        value=modifier.rankAdd localize=true
                        label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.rank-add.label")
                        rootId=partId}}

            {{formField @root.systemFields.talentModifiers.element.fields.rankLimit
                        name=(concat "system.talentModifiers." talentIdx ".rankLimit")
                        value=modifier.rankLimit localize=true
                        label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.rank-limit.label")
                        rootId=partId}}

            <fieldset>
                <legend data-tooltip="SWES.Species-Item.talent-modifiers.requirement.hint">{{localize
                        "SWES.Species-Item.talent-modifiers.requirement.label"}}</legend>

                {{formField @root.systemFields.talentModifiers.element.fields.requirement.fields.wearingArmor
                            value=modifier.requirement.wearingArmor  localize=true
                            name=(concat "system.talentModifiers." talentIdx ".requirement.wearingArmor")
                            label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.requirement.wearing-armor.label")
                            rootId=partId}}
                {{formField @root.systemFields.talentModifiers.element.fields.requirement.fields.career
                            value=modifier.requirement.career
                            name=(concat "system.talentModifiers." talentIdx ".requirement.career")
                            label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.requirement.career.label")}}
                {{formField @root.systemFields.talentModifiers.element.fields.requirement.fields.specialization
                            value=modifier.requirement.specialization
                            name=(concat "system.talentModifiers." talentIdx ".requirement.specialization")
                            label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.requirement.specialization.label")}}
                {{formField @root.systemFields.talentModifiers.element.fields.requirement.fields.nonCareer
                            value=modifier.requirement.nonCareer
                            name=(concat "system.talentModifiers." talentIdx ".requirement.nonCareer")
                            label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.requirement.non-career.label")}}
                {{formField @root.systemFields.talentModifiers.element.fields.requirement.fields.soakAtLeast
                            value=modifier.requirement.soakAtLeast
                            name=(concat "system.talentModifiers." talentIdx ".requirement.soakAtLeast")
                            label=(localize "SWES.Species-Item.FIELDS.talent-modifiers.requirement.soak-at-least.label")}}

            </fieldset>
        </fieldset>

    {{/each}}

</section>