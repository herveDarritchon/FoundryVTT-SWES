{{! Starting Characteristics Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesStartingChars'
>

    <h3>{{localize "SWES.Item.Tabs.AttributesStartingChars"}}</h3>

    <fieldset>
        <legend data-tooltip="SWES.Species-Item.starting-chars.hint">{{localize
                "SWES.Species-Item.starting-chars.label"}}</legend>

        {{formField systemFields.startingChars.fields.brawn value=system.startingChars.brawn localize=true}}
        {{formField systemFields.startingChars.fields.agility value=system.startingChars.agility localize=true}}
        {{formField systemFields.startingChars.fields.intellect value=system.startingChars.intellect localize=true}}
        {{formField systemFields.startingChars.fields.cunning value=system.startingChars.cunning localize=true}}
        {{formField systemFields.startingChars.fields.willpower value=system.startingChars.willpower localize=true}}
        {{formField systemFields.startingChars.fields.presence value=system.startingChars.presence localize=true}}

    </fieldset>

    <fieldset>
        <legend data-tooltip="SWES.Species-Item.starting-chars.requirement.hint">{{localize
                "SWES.Species-Item.starting-chars.requirement.label"}}</legend>

        {{formField systemFields.startingChars.fields.requirement.fields.wearingArmor
                    value=system.startingChars.requirement.wearingArmor localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.career
                    value=system.startingChars.requirement.career localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.specialization
                    value=system.startingChars.requirement.specialization localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.nonCareer
                    value=system.startingChars.requirement.nonCareer localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.soakAtLeast
                    value=system.startingChars.requirement.soakAtLeast localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.wieldingMelee
                    value=system.startingChars.requirement.wieldingMelee localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.wieldingBrawl
                    value=system.startingChars.requirement.wieldingBrawl localize=true}}
        {{formField systemFields.startingChars.fields.requirement.fields.wieldingLightsaber
                    value=system.startingChars.requirement.wieldingLightsaber localize=true}}

    </fieldset>

</section>