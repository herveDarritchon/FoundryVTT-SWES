{{! Starting Attributes Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesStartingAttributes'
>

    <h3>{{localize "SWES.Item.Tabs.AttributesStartingAttributes"}}</h3>

    <fieldset>
        <legend data-tooltip="SWES.Species-Item.starting-attrs.hint">{{localize
                "SWES.Species-Item.starting-attrs.label"}}</legend>

        {{formField systemFields.startingAttrs.fields.woundThreshold value=system.startingAttrs.woundThreshold
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.wound-threshold.label")}}
        {{formField systemFields.startingAttrs.fields.strainThreshold value=system.startingAttrs.strainThreshold
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.strain-threshold.label")}}
        {{formField systemFields.startingAttrs.fields.defenseRanged value=system.startingAttrs.defenseRanged
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.defense-ranged.label")}}
        {{formField systemFields.startingAttrs.fields.defenseMelee value=system.startingAttrs.defenseMelee
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.defense-melee.label")}}
        {{formField systemFields.startingAttrs.fields.soakValue value=system.startingAttrs.soakValue
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.soak-value.label")}}
        {{formField systemFields.startingAttrs.fields.experience value=system.startingAttrs.experience
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.experience.label")}}
        {{formField systemFields.startingAttrs.fields.forceRating value=system.startingAttrs.forceRating
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.force-rating.label")}}
        {{formField systemFields.startingAttrs.fields.encumbranceBonus value=system.startingAttrs.encumbranceBonus
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.encumbrance-bonus.label")}}
    </fieldset>

    <fieldset>
        <legend data-tooltip="SWES.Species-Item.starting-attrs.requirement.hint">{{localize
                "SWES.Species-Item.starting-attrs.requirement.label"}}</legend>

        {{formField systemFields.startingAttrs.fields.requirement.fields.wearingArmor value=system.startingAttrs.requirement.wearingArmor
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.wearing-armor.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.career value=system.startingAttrs.requirement.career
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.career.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.specialization value=system.startingAttrs.requirement.specialization
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.specialization.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.nonCareer value=system.startingAttrs.requirement.nonCareer
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.non-career.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.soakAtLeast value=system.startingAttrs.requirement.soakAtLeast
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.soak-at-least.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.wieldingMelee value=system.startingAttrs.requirement.wieldingMelee
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.wielding-melee.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.wieldingBrawl value=system.startingAttrs.requirement.wieldingBrawl
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.wielding-brawl.label")}}
        {{formField systemFields.startingAttrs.fields.requirement.fields.wieldingLightsaber value=system.startingAttrs.requirement.wieldingLightsaber
                    label=(localize "SWES.Species-Item.FIELDS.starting-attrs.requirement.wielding-light-saber.label")}}
    </fieldset>

</section>