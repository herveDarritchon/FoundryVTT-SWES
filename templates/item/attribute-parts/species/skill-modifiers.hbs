{{! Skill Modifiers Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='attributesSkillModifiers'
>

    <h3>{{localize "SWES.Item.Tabs.AttributesSkillModifiers"}}</h3>


    {{#each system.skillModifiers as |modifier modIdx|}}
        <fieldset>
            <legend data-tooltip="SWES.Species-Item.skill-modifiers.hint">{{localize
                    "SWES.Species-Item.skill-modifiers.label"}}</legend>

            {{formField @root.systemFields.skillModifiers.element.fields.key
                        name=(concat "system.skillModifiers." modIdx ".key")
                        value=modifier.key localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.key.label")
                        rootId=partId}}

            {{formField @root.systemFields.skillModifiers.element.fields.subSpeciesKey
                        name=(concat "system.skillModifiers." modIdx ".subSpeciesKey")
                        value=modifier.subSpeciesKey localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.sub-species-key.label")
                        rootId=partId}}

            {{formField @root.systemFields.skillModifiers.element.fields.rankStart
                        name=(concat "system.skillModifiers." modIdx ".rankStart")
                        value=modifier.rankStart localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.rank-start.label")
                        rootId=partId}}

            {{formField @root.systemFields.skillModifiers.element.fields.rankAdd
                        name=(concat "system.skillModifiers." modIdx ".rankAdd")
                        value=modifier.rankAdd localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.rank-add.label")
                        rootId=partId}}

            {{formField @root.systemFields.skillModifiers.element.fields.rankLimit
                        name=(concat "system.skillModifiers." modIdx ".rankLimit")
                        value=modifier.rankLimit localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.rank-limit.label")
                        rootId=partId}}

            {{formField @root.systemFields.skillModifiers.element.fields.isCareer
                        name=(concat "system.skillModifiers." modIdx ".isCareer")
                        value=modifier.isCareer localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.is-career.label")
                        rootId=partId}}

            {{formField @root.systemFields.skillModifiers.element.fields.skillType
                        name=(concat "system.skillModifiers." modIdx ".skillType")
                        value=modifier.skillType localize=true
                        label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.skill-type.label")
                        rootId=partId}}

            <fieldset>
                <legend data-tooltip="SWES.Species-Item.skill-modifiers.requirement.hint">{{localize
                        "SWES.Species-Item.skill-modifiers.requirement.label"}}</legend>

                {{formField @root.systemFields.skillModifiers.element.fields.requirement.fields.wearingArmor
                            value=modifier.requirement.wearingArmor  localize=true
                            name=(concat "system.skillModifiers." modIdx ".requirement.wearingArmor")
                            label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.requirement.wearing-armor.label")
                            rootId=partId}}
                {{formField @root.systemFields.skillModifiers.element.fields.requirement.fields.career
                            value=modifier.requirement.career
                            name=(concat "system.skillModifiers." modIdx ".requirement.career")
                            label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.requirement.career.label")}}
                {{formField @root.systemFields.skillModifiers.element.fields.requirement.fields.specialization
                            value=modifier.requirement.specialization
                            name=(concat "system.skillModifiers." modIdx ".requirement.specialization")
                            label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.requirement.specialization.label")}}
                {{formField @root.systemFields.skillModifiers.element.fields.requirement.fields.nonCareer
                            value=modifier.requirement.nonCareer
                            name=(concat "system.skillModifiers." modIdx ".requirement.nonCareer")
                            label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.requirement.non-career.label")}}
                {{formField @root.systemFields.skillModifiers.element.fields.requirement.fields.soakAtLeast
                            value=modifier.requirement.soakAtLeast
                            name=(concat "system.skillModifiers." modIdx ".requirement.soakAtLeast")
                            label=(localize "SWES.Species-Item.FIELDS.skill-modifiers.requirement.soak-at-least.label")}}
            </fieldset>
        </fieldset>

    {{/each}}

</section>
