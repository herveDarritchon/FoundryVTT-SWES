{{! Description Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='description'
>

    <h1>Details</h1>

    <fieldset>

        {{formField systemFields.key value=system.key
                    placeholder=(localize "SWES.Combat-Item.FIELDS.key.placeholder")}}

        {{formField systemFields.type value=system.type
                    placeholder=(localize "SWES.Combat-Item.FIELDS.type.placeholder")}}

        {{formField systemFields.price value=system.price
                    placeholder=(localize "SWES.Combat-Item.FIELDS.price.placeholder")}}

    </fieldset>

    <h3>Description</h3>
    {{! Editors must receive enriched text data from getData to properly handle rolls, UUID links, etc. }}

    <section class="item-description">
        <fieldset>
            <legend data-tooltip="SWES.Combat-Item.FIELDS.description.hint">{{localize
                    "SWES.Combat-Item.FIELDS.description.label"}}</legend>
            {{formInput
                    systemFields.description
                    enriched=enrichedDescription
                    value=system.description
                    documentUUID=item.uuid
                    name="system.description"
                    collaborate="false"
                    toggled="true"
                    height="50"
            }}
        </fieldset>
    </section>

{{!--
{{#if editable}}
        <prose-mirror name="system.description" data-document-u-u-i-d="{{item.uuid}}" value="{{system.description}}"
                      collaborate="true" toggled="true">
            {{{enrichedDescription}}}
        </prose-mirror>
    {{else}}
        {{{enrichedDescription}}}
    {{/if}}
--}}

    <fieldset>
        {{#each system.sources as |source|}}
            <label for="source">{{localize "ARMOR.Sheet.details.source.label"}}</label>
            <input id="source" name="system.description" type="text" value="{{source.description}}"
                   placeholder="Description"/>

            <label for="page">{{localize "ARMOR.Sheet.details.page.label"}}</label>
            <input id="page" name="system.page" type="number" value="{{source.page}}" placeholder="Page"/>
        {{/each}}
    </fieldset>

</section>