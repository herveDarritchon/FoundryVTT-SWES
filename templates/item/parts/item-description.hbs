{{! Description Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='description'
>

    <h3>Description</h3>
    {{! Editors must receive enriched text data from getData to properly handle rolls, UUID links, etc. }}

    <section class="item-description">
        <fieldset>
            <legend data-tooltip="SWES.Combat-Item.FIELDS.description.hint">{{localize
                    "SWES.Combat-Item.FIELDS.description.label"}}</legend>
            {{formInput
                    systemFields.description
                    enriched=enrichedDescription
                    value=system.description
                    documentUUID=actor.uuid
                    name="system.description"
                    collaborate=false
                    toggled="true"
                    height="200"
            }}
        </fieldset>
    </section>

    <fieldset>
        <legend data-tooltip="SWES.Combat-Item.FIELDS.sources.hint">{{localize
                "SWES.Combat-Item.FIELDS.sources.label"}}</legend>
        {{#each system.sources as |source idx|}}
            {{formField @root.systemFields.sources.element.fields.description
                        name=(concat "system.sources." idx ".description")
                        value=source.description localize=true
                        label="SWES.Combat-Item.FIELDS.sources.element.FIELDS.description.label"
                        rootId=partId}}
            {{formField @root.systemFields.sources.element.fields.page
                        name=(concat "system.sources." idx ".page")
                        value=source.page localize=true
                        label="SWES.Combat-Item.FIELDS.sources.element.FIELDS.page.label"
                        rootId=partId}}
        {{/each}}

    </fieldset>

    {{!--
    {{formField @root.systemFields.sources value=system.sources localize=true
                rootId=partId}}
    --}}

</section>