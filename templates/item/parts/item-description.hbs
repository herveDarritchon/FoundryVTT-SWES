{{! Description Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='description'
>

    <h3>Description</h3>
    {{! Editors must receive enriched text data from getData to properly handle rolls, UUID links, etc. }}

    <section class="item-description">
        <fieldset>
            <legend data-tooltip="SWES.Combat-Item.FIELDS.description.hint">{{localize
                    "SWES.Combat-Item.FIELDS.description.label"}}</legend>
            {{formInput
                    systemFields.description
                    enriched=enrichedDescription
                    value=system.description
                    documentUUID=actor.uuid
                    name="system.description"
                    collaborate="true"
                    toggled="true"
                    height="200"
            }}
        </fieldset>
    </section>

    {{!--
    {{#if editable}}
            <prose-mirror name="system.description" data-document-u-u-i-d="{{item.uuid}}" value="{{system.description}}"
                          collaborate="true" toggled="true">
                {{{enrichedDescription}}}
            </prose-mirror>
        {{else}}
            {{{enrichedDescription}}}
        {{/if}}
    --}}

    <fieldset>
        {{#each system.sources as |source|}}
            {{formField @root.systemFields.sources.element.description value=source.description localize=true
                        rootId=partId}}
            {{formField @root.systemFields.sources.element.page value=source.page localize=true rootId=partId}}
        {{/each}}
    </fieldset>

</section>