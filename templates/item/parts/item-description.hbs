{{! Description Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='description'
>

    <h3>{{localize "SWES.Item.Tabs.Description"}}</h3>

    <section class="item-description">
        <fieldset>
            <legend data-tooltip="SWES.Base-Item.description.hint">{{localize
                    "SWES.Base-Item.description.label"}}</legend>
            {{formInput
                    systemFields.description
                    enriched=enrichedDescription
                    value=system.description
                    documentUUID=actor.uuid
                    name="system.description"
                    collaborate=false
                    toggled="true"
                    height="200"
            }}
        </fieldset>
    </section>

    <fieldset>
        <legend data-tooltip="SWES.Base-Item.FIELDS.sources.hint">{{localize
                "SWES.Base-Item.FIELDS.sources.label"}}</legend>
        {{#each system.sources as |source idx|}}
            {{formField @root.systemFields.sources.element.fields.description
                        name=(concat "system.sources." idx ".description")
                        value=source.description localize=true rootId=partId}}
            {{formField @root.systemFields.sources.element.fields.page
                        name=(concat "system.sources." idx ".page")
                        value=source.page localize=true rootId=partId}}
        {{/each}}

    </fieldset>

</section>