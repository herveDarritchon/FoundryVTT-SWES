{{! Description Tab }}
<section
        class='tab {{tab.cssClass}}'
        data-group='primary'
        data-tab='details'
>

    <h3>Details</h3>

    <fieldset>

        {{formField systemFields.key value=system.key
                    placeholder=(localize "SWES.Combat-Item.FIELDS.key.placeholder")}}

        {{formField systemFields.type value=system.type
                    placeholder=(localize "SWES.Combat-Item.FIELDS.type.placeholder")}}

        {{formField systemFields.price value=system.price
                    placeholder=(localize "SWES.Combat-Item.FIELDS.price.placeholder")}}

        {{formField systemFields.restricted value=system.resticted
                    placeholder=(localize "SWES.Combat-Item.FIELDS.rectricted.placeholder")}}
    </fieldset>

</section>